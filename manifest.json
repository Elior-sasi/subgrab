{
  "manifest_version": 3,
  "name": "SubGrab",
  "version": "0.4.0",
  "description": "Automatically detect accessible subtitle tracks used by web video players and export them as SRT.",
  "permissions": ["activeTab", "downloads", "scripting", "webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "SubGrab", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start"}],
  "browser_specific_settings": {"gecko": {"id": "subgrab@elior-sasi", "strict_min_version": "109.0"}}
}