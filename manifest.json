{
  "manifest_version": 3,
  "name": "SubGrab",
  "version": "0.1.0",
  "description": "Detect subtitle tracks used by web video players and export accessible tracks as SRT.",
  "permissions": ["activeTab", "downloads", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "SubGrab",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "subgrab@elior-sasi",
      "strict_min_version": "109.0"
    }
  }
}